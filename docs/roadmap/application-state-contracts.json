          "evidence": [{"path": "apps/flightschool/app_secrets.py", "contains": ["create_secret_loader('flightschool')", "default='dev'", "default='csrf-key'"]}]
        }
      ],
      "gaps": ["Production configuration does not fail closed when SECRET_KEY or CSRF key is absent"]
    },
