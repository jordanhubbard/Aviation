            {"path": "apps/flightschool/config.py", "contains": ["SQLALCHEMY_DATABASE_URI", "sqlite:///flightschool.db"]},
            {"path": "apps/flightschool/app/__init__.py", "contains": ["Migrate", "migrate.init_app"]}
          ]
        }
