      "credentials": [
        {
          "id": "application-and-integrations",
          "provider": "keystore-and-environment",
          "namespace": "flightschool",
          "keys": ["SECRET_KEY", "WTF_CSRF_SECRET_KEY", "MAIL_PASSWORD", "GOOGLE_CLIENT_SECRET"],
          "precedence": "flightschool keystore, then environment fallback",
          "missingBehavior": "SECRET_KEY and CSRF key use known development defaults; integrations are disabled",
