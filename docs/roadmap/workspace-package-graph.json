      "componentOwners": [
        "aviation.aircraft", "aviation.airports", "aviation.alerts", "aviation.avionics",
        "aviation.configuration", "aviation.flight-dynamics", "aviation.hazards",
        "aviation.logbook", "aviation.navigation", "aviation.nav-data", "aviation.notam",
