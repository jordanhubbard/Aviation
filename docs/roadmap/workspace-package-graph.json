    {"path":"apps/g1000-simulator/frontend","name":"g1000-simulator-frontend","application":"g1000-simulator","workspaceDependencies":["@aviation/aviation-config","@aviation/g1000-protocols","@aviation/g1000-rendering","@aviation/shared-sdk"],"buildScript":"vite build","testScript":null},
