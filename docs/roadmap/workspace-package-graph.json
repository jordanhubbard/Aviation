{
  "$schema": "aviation/workspace-package-graph@1",
  "revision": 1,
  "authority": "retained-build-inventory",
  "boundary": "Workspace membership and build orchestration are repository infrastructure. A package is Component authority only when its classification names a qualified native Component; application packages remain private adapters and composition.",
  "workspace": {
    "root": "components/legacy-project-wrapper/implementation",
    "packageManager": "pnpm@10.34.5",
    "manifest": "pnpm-workspace.yaml",
    "globs": ["packages/*", "apps/*", "apps/*/frontend", "apps/*/backend"],
    "rootWorkspaceDependencies": ["@aviation/shared-sdk"]
  },
  "sharedPackages": [
    {
      "path": "packages/ai-explainer",
      "name": "@aviation/ai-explainer",
      "classification": "shared-application-service",
      "componentOwners": [],
      "workspaceDependencies": [],
      "buildScript": "tsc",
      "testScript": "vitest run",
      "testGate": "monorepo-ci"
    },
    {
      "path": "packages/aviation-config",
