{
  "name": "@aviation/aviation-chat",
  "version": "0.1.0",
  "description": "Proxy for OpenClaw in-app chat; loads app CLAUDE.md and forwards to OpenClaw with user/app context",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["aviation", "openclaw", "chat"],
  "author": "Jordan Hubbard",
  "license": "MIT",
  "dependencies": {
    "@aviation/keystore": "*",
    "@aviation/shared-sdk": "*",
    "express": "^4.21.0",
    "cors": "^2.8.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
