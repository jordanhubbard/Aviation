{
  "name": "@aviation/flight-tracker",
  "version": "0.1.0",
  "description": "Flight tracking application that monitors real-time flight data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "test:watch": "vitest"
  },
  "keywords": [
    "aviation",
    "flight-tracker"
  ],
  "author": "Jordan Hubbard",
  "license": "MIT",
  "dependencies": {
    "@aviation/ai-explainer": "workspace:*",
    "@aviation/shared-sdk": "workspace:*",
    "@aviation/keystore": "workspace:*",
    "@aviation/ui-framework": "workspace:*",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
