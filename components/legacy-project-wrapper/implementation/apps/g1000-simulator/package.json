{
  "name": "@aviation/g1000-simulator",
  "version": "0.1.0",
  "description": "G1000 flight simulator with real-time data streaming and command ingestion",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "echo 'No lint config \u2014 skipping' && exit 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aviation/shared-sdk": "workspace:*",
    "ws": "^8.14.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.8",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.9.3",
    "eslint": "^10.15.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
