{
  "name": "g1000-simulator-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@aviation/ai-explainer": "workspace:*",
    "@aviation/aviation-config": "workspace:*",
    "@aviation/g1000-protocols": "workspace:*",
    "@aviation/g1000-rendering": "workspace:*",
    "@aviation/shared-sdk": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.3.3",
    "typescript": "^5.9.3",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "jsdom": "^31.0.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test:procedures": "vitest run --config vitest.procedures.config.mts",
    "type-check:procedures": "tsc --noEmit --skipLibCheck --target ES2020 --module ESNext --moduleResolution bundler --jsx react-jsx --strict src/pages/ProceduresPage.tsx src/vite-env.d.ts",
    "test:navigation": "node e2e/navigation-acceptance.mjs"
  },
  "overrides": {
    "minimatch": ">=9.0.7",
    "rollup": ">=4.59.0"
  }
}
