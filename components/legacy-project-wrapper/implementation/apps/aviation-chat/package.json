{
  "name": "@aviation/aviation-chat",
  "version": "0.1.0",
  "description": "Proxy for OpenClaw in-app chat; loads app CLAUDE.md and forwards to OpenClaw with user/app context",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aviation",
    "openclaw",
    "chat"
  ],
  "author": "Jordan Hubbard",
  "license": "MIT",
  "dependencies": {
    "@aviation/ai-explainer": "workspace:*",
    "@aviation/keystore": "workspace:*",
    "@aviation/shared-sdk": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "5.1.1"
  }
}
