# App
ENVIRONMENT=development

# External APIs
OPENWEATHERMAP_API_KEY=
OPENAIP_API_KEY=
OPENTOPOGRAPHY_API_KEY=

# Frontend (optional)
# If unset, frontend runtime config will fall back to OPENWEATHERMAP_API_KEY.
VITE_OPENWEATHERMAP_API_KEY=

# Optional server-side GitHub runtime issue reporting (disabled by default)
# GITHUB_ISSUES_REPOSITORY=jordanhubbard/Aviation
# GITHUB_ISSUES_TOKEN=
# GITHUB_ISSUES_AUTOREPORT=1

# Optional
# DATABASE_URL=
# REDIS_URL=
