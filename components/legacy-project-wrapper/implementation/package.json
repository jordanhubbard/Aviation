{
  "name": "aviation-monorepo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/*/frontend",
    "apps/*/backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:remote": "node deploy/remote-e2e.mjs",
    "keystore:init": "ts-node scripts/keystore-cli.ts init",
    "keystore:services": "ts-node scripts/keystore-cli.ts services",
    "keystore": "ts-node scripts/keystore-cli.ts",
    "keystore set": "ts-node scripts/keystore-cli.ts set",
    "keystore get": "ts-node scripts/keystore-cli.ts get",
    "keystore list": "ts-node scripts/keystore-cli.ts list",
    "secrets:migrate": "ts-node scripts/migrate-secrets.ts"
  },
  "devDependencies": {
    "@aviation/shared-sdk": "workspace:*",
    "@playwright/test": "^1.0.0",
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@tootallnate/once": ">=3.0.1",
    "express-rate-limit": ">=8.2.2",
    "minimatch": ">=11.0.0",
    "nth-check": ">=2.1.1",
    "postcss": ">=8.4.31",
    "qs": ">=6.14.2",
    "rollup": ">=4.59.0",
    "serialize-javascript": ">=7.0.3",
    "tar": ">=7.5.22",
    "underscore": ">=1.13.8",
    "webpack-dev-server": ">=5.2.1",
    "esbuild": ">=0.24.3"
  }
}
