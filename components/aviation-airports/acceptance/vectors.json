    {
      "id": "exact-search-ranking",
      "operation": "search_codes",
      "args": [
        "KBBB",
        2
      ],
      "expected": [
        "KBBB"
      ]
    },
    {
      "id": "nearby-order-and-units",
      "operation": "nearby",
      "args": [
        0,
        0,
        65,
        3
      ],
      "expected": [
        {
          "icao": "KAAA",
          "distance_nm": 0,
          "absolute_tolerance": 0
        },
        {
          "icao": "KBBB",
          "distance_nm": 60.04,
          "absolute_tolerance": 0.01
        }
      ]
    },
    {
      "id": "exact-iata-before-prefixed-alias",
