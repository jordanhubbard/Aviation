      "args": [
        "KAAA"
      ],
      "expected": {
        "icao": "KAAA",
        "elevation": 100
      }
    },
    {
      "id": "exact-iata-after-icao-cache",
      "operation": "lookup",
      "args": [
        "aaa"
      ],
      "expected": {
        "icao": "FZZZ",
        "elevation": 200
      }
    },
    {
      "id": "exact-icao-case-insensitive",
      "operation": "lookup",
      "args": [
        "kaaa"
      ],
      "expected": {
        "icao": "KAAA",
        "elevation": 100
      }
    },
    {
      "id": "unambiguous-prefix-fallback",
      "operation": "lookup",
      "args": [
        "BBB"
      ],
      "expected": {
