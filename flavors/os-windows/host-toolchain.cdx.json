{
  "$schema": "http://cyclonedx.org/schema/bom-1.7.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.7",
  "serialNumber": "urn:uuid:26fc5830-bfb4-4582-925a-3567990af94a",
  "version": 1,
  "metadata": {
    "component": {"type": "application", "bom-ref": "urn:literate-ai:toolchain:os-windows", "name": "os-windows", "version": "1.0.0"},
    "properties": [{"name": "literate-ai:base-toolchain:role", "value": "mixin"}]
  },
  "components": [
    {
      "type": "application", "bom-ref": "urn:literate-ai:capability:bash", "name": "Windows Bash compatibility shell", "version": ">=4,<6",
      "properties": [
        {"name": "literate-ai:base-toolchain:capability", "value": "bash"},
        {"name": "literate-ai:base-toolchain:probe-kind", "value": "command"},
        {"name": "literate-ai:base-toolchain:probe-candidates", "value": "[\"bash.exe\",\"%ProgramFiles%/Git/bin/bash.exe\",\"%ProgramW6432%/Git/bin/bash.exe\"]"},
        {"name": "literate-ai:base-toolchain:probe-arguments", "value": "[\"--version\"]"},
        {"name": "literate-ai:base-toolchain:reason", "value": "Windows Bazel actions use the Bash compatibility shell shipped by Git for Windows."}
      ]
    },
    {
      "type": "application", "bom-ref": "urn:literate-ai:capability:vcruntime", "name": "Microsoft Visual C++ runtime", "version": ">=14,<15",
      "properties": [
        {"name": "literate-ai:base-toolchain:capability", "value": "vcruntime"},
        {"name": "literate-ai:base-toolchain:probe-kind", "value": "file-group"},
        {"name": "literate-ai:base-toolchain:probe-candidates", "value": "[\"%SystemRoot%/System32/MSVCP140.dll\",\"%SystemRoot%/System32/VCRUNTIME140.dll\",\"%SystemRoot%/System32/VCRUNTIME140_1.dll\"]"},
        {"name": "literate-ai:base-toolchain:reason", "value": "Native Windows coding agents and generated binaries require the complete VC14 runtime set."}
      ]
    }
  ],
  "dependencies": [
    {"ref": "urn:literate-ai:toolchain:os-windows", "dependsOn": ["urn:literate-ai:capability:bash", "urn:literate-ai:capability:vcruntime"]},
    {"ref": "urn:literate-ai:capability:bash", "dependsOn": []},
    {"ref": "urn:literate-ai:capability:vcruntime", "dependsOn": []}
  ]
}
