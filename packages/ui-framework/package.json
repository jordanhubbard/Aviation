{
  "name": "@aviation/ui-framework",
  "version": "0.1.0",
  "type": "module",
  "description": "UI framework supporting both self-contained mobile and multi-tab web interfaces",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "default": "./dist/map/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "aviation",
    "ui",
    "framework",
    "mobile",
    "web"
  ],
  "author": "Jordan Hubbard",
  "license": "MIT",
  "dependencies": {
    "@aviation/shared-sdk": "workspace:*",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  }
}
